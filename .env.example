# Atlas frontend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Base URL of the Atlas backend API.
# - Local dev with the Vite proxy: use /api (default when unset).
# - Deployed: the full https URL of the Render server, e.g.
#   VITE_API_BASE_URL=https://sindyan-atlas-server.onrender.com/api
VITE_API_BASE_URL=/api
